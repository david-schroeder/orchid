"""
3-bit R-2R DAC with unbuffered output: vout = vdd * code / 8, code = d[2:0].

Stdcell buffers drive the ladder rail to rail. The ladder is built from one unit
resistor (2R = two units in series, for matching), large against the buffers' output
resistance.
"""

from ordec.core import *
from ordec.layout import SRouter
from ordec.lib.ihp130 import SG13G2, Rhigh, Ptap
from ams import stdcells

N = 3       # bits
R_L = 4u    # unit resistor: Rhigh, about 12 kOhm
R_W = 500n

Buf = stdcells.cell("buf_1")


cell DacDrivers:
    """One buffer per bit: d[i] -> b[i]."""

    viewgen symbol(self) -> Symbol:
        inout vdd: .orient=North
        inout vss: .orient=South
        path d, b
        for i in range(N):
            input d[i]: .orient=West
            output b[i]: .orient=East

    viewgen schematic(self) -> Schematic:
        port vdd: .pos=(0, 8 * N + 2); .orient=East
        port vss: .pos=(0, 0); .orient=East
        path d, b, buf
        for i in range(N):
            port d[i]: .pos=(0, 8 * i + 4); .orient=East
            port b[i]: .pos=(20, 8 * i + 4); .orient=West
            Buf buf[i]:
                .pos = (7, 8 * i + 2)
                .A -- d[i]; .X -- b[i]
                .VDD -- vdd; .VSS -- vss

    viewgen layout(self) -> Layout:
        # Inputs leave at the bottom, ladder drives at the top (towards R2r).
        edges = {f"d[{i}]": "bottom" for i in range(N)} | {f"b[{i}]": "top" for i in range(N)}
        stdcells.pnr(self.schematic, ., port_edges=edges)


cell R2r:
    """R-2R ladder: input b[i] has weight 2^i / 2^N; the LSB end is terminated by 2R to vss."""

    viewgen symbol(self) -> Symbol:
        output vout: .orient=East
        inout vss: .orient=South
        path b
        for i in range(N):
            input b[i]: .orient=West

    viewgen schematic(self) -> Schematic:
        port vss: .pos=(0, 0); .orient=East
        port vout: .pos=(10 * N + 6, 18); .orient=West

        # node[i]: ladder node of bit i (node[N-1] = vout); m[i]: middle of its 2R branch.
        path b, n, m, ra, rb, rs
        node = []
        for i in range(N - 1):
            net n[i]
            node.append(n[i])
        node.append(vout)

        # Termination: 2R from node[0] to vss.
        net mt
        Rhigh rt0: .pos=(0, 4); .$l=R_L; .$w=R_W; .n -- vss; .p -- mt; .sub -- vss
        Rhigh rt1: .pos=(0, 10); .$l=R_L; .$w=R_W; .n -- mt; .p -- node[0]; .sub -- vss

        for i in range(N):
            x = 10 * i + 8
            port b[i]: .pos=(x + 2, -2); .orient=North
            net m[i]
            Rhigh ra[i]: .pos=(x, 4); .$l=R_L; .$w=R_W; .n -- b[i]; .p -- m[i]; .sub -- vss
            Rhigh rb[i]: .pos=(x, 10); .$l=R_L; .$w=R_W; .n -- m[i]; .p -- node[i]; .sub -- vss
            if i < N - 1:
                Rhigh rs[i]:
                    .pos = (x + 8, 20); .orient = East
                    .$l = R_L; .$w = R_W
                    .n -- node[i]; .p -- node[i + 1]; .sub -- vss

    viewgen layout(self) -> Layout:
        # Columns COL apart: termination (rt0 below rt1), then one 2R stack per bit
        # (ra[i] below rb[i]). The series resistors rs[i] lie horizontally above,
        # between the tops of the stacks of bits i and i + 1. Wiring on Metal1.
        .ref_layers = SG13G2().layers
        layers = .ref_layers
        sr = SRouter(SG13G2().default_routing_spec)
        COL = 6000
        STACK = 5780    # y of the upper resistor of a stack
        SERIES = 1400   # series row above the stack tops
        RS_OFS = 720    # series resistor terminals beside the column centres

        path ra, rb, rs, b
        Rhigh(l=R_L, w=R_W) rt0:
            ! .pos == (0, 0)
        Rhigh(l=R_L, w=R_W) rt1:
            ! .pos == (0, STACK)
        lower = [rt0]
        upper = [rt1]
        for i in range(N):
            Rhigh(l=R_L, w=R_W) ra[i]:
                ! .pos == ((i + 1) * COL, 0)
            Rhigh(l=R_L, w=R_W) rb[i]:
                ! .pos == ((i + 1) * COL, STACK)
            lower.append(ra[i])
            upper.append(rb[i])
        for lo, up in zip(lower, upper):
            sr.move(layers.Metal1, lo.term_p.center)
            sr.wire_y(up.term_n.cy)

        # Ladder nodes: tops of the stacks, joined by the series resistors.
        y_series = rb[0].term_p.cy + SERIES
        for i in range(N - 1):
            Rhigh(l=R_L, w=R_W) rs[i]:
                .orient = R270
                ! .term_n.cx == rb[i].term_p.cx + RS_OFS
                ! .term_n.cy == y_series
        for i in range(N):
            sr.move(layers.Metal1, rb[i].term_p.center)
            sr.wire_y(y_series)
            if i < N - 1:
                sr.wire_x(rb[i].term_p.cx + RS_OFS)
            if i > 0:
                sr.move(layers.Metal1, (rb[i].term_p.cx, y_series))
                sr.wire_x(rb[i].term_p.cx - RS_OFS)
        # Termination into node 0.
        sr.move(layers.Metal1, rt1.term_p.center)
        sr.wire_y(y_series)
        sr.wire_x(rb[0].term_p.cx)

        # Substrate tap next to the termination, on vss.
        Ptap(l=0.7u, w=0.7u) tap:
            ! .m1.cy == rt0.term_n.cy
            ! .m1.ux == rt0.term_n.lx - 1500
        sr.move(layers.Metal1, tap.m1.center)
        sr.wire_x(rt0.term_n.cx)

        LayoutRect vss:
            .layer = layers.Metal1
            ! .rect == tap.m1.rect
            .create_pin(self.symbol.vss)
        LayoutRect vout:
            .layer = layers.Metal1
            ! .rect == rb[N - 1].term_p.rect
            .create_pin(self.symbol.vout)
        for i in range(N):
            LayoutRect b[i]:
                .layer = layers.Metal1
                ! .rect == ra[i].term_n.rect
                .create_pin(self.symbol.b[i])


cell Dac:
    """3-bit R-2R DAC: vout = vdd * code / 8 (unbuffered)."""

    viewgen symbol(self) -> Symbol:
        output vout: .orient=East
        inout vdd: .orient=North
        inout vss: .orient=South
        path d
        for i in range(N):
            input d[i]: .orient=West

    viewgen schematic(self) -> Schematic:
        port vdd: .pos=(0, 20); .orient=East
        port vss: .pos=(0, 0); .orient=East
        port vout: .pos=(40, 10); .orient=West
        path d, b
        for i in range(N):
            port d[i]: .pos=(0, 4 * i + 6); .orient=East
            net b[i]

        DacDrivers drv:
            .pos = (6, 4)
            .vdd -- vdd; .vss -- vss
            for i in range(N):
                .d[i] -- d[i]; .b[i] -- b[i]
        R2r ladder:
            .pos = (24, 4)
            .vout -- vout; .vss -- vss
            for i in range(N):
                .b[i] -- b[i]

    viewgen layout(self) -> Layout:
        # Drivers at the bottom, ladder above (positions put the lower left corner of the
        # macro at the origin). Each driver output rises on Metal4 to its own channel,
        # runs on Metal3 to its ladder column and drops on Metal2.
        .ref_layers = SG13G2().layers
        layers = .ref_layers
        sr = SRouter(SG13G2().default_routing_spec)
        port = stdcells.port
        CHANNEL = 1000  # channel pitch above the drivers

        DacDrivers drv:
            ! .pos == (2110, 360)
        drv_vss = port(drv, "vss")
        b0 = port(drv, "b", 0)
        R2r ladder:
            ! .pos == (2110, b0.uy + (N + 2) * CHANNEL)

        for i in range(N):
            src = port(drv, "b", i)
            dst = ladder.b[i]
            sr.move(layers.Metal4, src.center)
            sr.wire_y(src.uy + (i + 1) * CHANNEL)
            sr.layer(layers.Metal3)
            sr.wire_x(dst.cx)
            sr.layer(layers.Metal2)
            sr.wire_y(dst.cy)
            sr.layer(layers.Metal1)

        # Ladder ground (substrate tap) down to the drivers' vss rail, left of the drivers.
        sr.move(layers.Metal1, ladder.vss.center)
        sr.layer(layers.Metal2)
        sr.wire_y(drv_vss.cy)
        sr.layer(layers.Metal1)
        sr.wire_x(drv_vss.lx + 300)

        LayoutRect vdd:
            .layer = layers.Metal1
            ! .rect == port(drv, "vdd").rect
            .create_pin(self.symbol.vdd)
        LayoutRect vss:
            .layer = layers.Metal1
            ! .rect == drv_vss.rect
            .create_pin(self.symbol.vss)
        LayoutRect vout:
            .layer = layers.Metal1
            ! .rect == ladder.vout.rect
            .create_pin(self.symbol.vout)
        path d
        for i in range(N):
            LayoutRect d[i]:
                .layer = layers.Metal4
                ! .rect == port(drv, "d", i).rect
                .create_pin(self.symbol.d[i])
