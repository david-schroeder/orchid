"""
Testbench of the 3-bit R-2R DAC: steps through all codes and checks the settled
output against vdd * code / 8.
"""

from ordec.core import *
from ordec.lib.base import Vpulse, Vdc, Gnd, Cap
from ams.dac.dac import Dac, N

VDD = 1.2
STEP = 20e-9    # time per code
EDGE = 100e-12  # input rise/fall time
TOL = 0.25      # allowed error of the settled output, in LSB
LOAD = "100f"   # output load


cell DacTb:
    """Counts d through all codes, one code per STEP, with a capacitive load on vout."""

    viewgen schematic(self) -> Schematic:
        net vdd, vss, vout
        path d, vp
        for i in range(N):
            net d[i]

        Dac dut:
            .pos = (30, 8)
            .vdd -- vdd; .vss -- vss; .vout -- vout
            for i in range(N):
                .d[i] -- d[i]

        # d[i] toggles with period 2 * STEP * 2^i, so the code counts up every STEP.
        for i in range(N):
            step = STEP * 2 ** i
            Vpulse vp[i]:
                .pos = (2 + 8 * i, 10)
                .$initial_value = 0
                .$pulsed_value = VDD
                .$delay_time = step
                .$rise_time = EDGE
                .$fall_time = EDGE
                .$pulse_width = step - EDGE
                .$period = 2 * step
                .n -- vss; .p -- d[i]

        Vdc vdd_src: .pos=(24, 20); .$dc=VDD; .n -- vss; .p -- vdd
        Cap cl: .pos=(44, 4); .$c=LOAD; .p -- vout; .n -- vss
        Gnd gnd: .pos=(24, 0); .p -- vss

    viewgen sim_tran(self) -> Simulation:
        .simulate().tran(50p, 2 ** N * STEP)

    viewgen report_tran(self) -> Report:
        sim = self.sim_tran
        time = list(sim.time)
        vout = list(sim.vout.voltage)
        lsb = VDD / 2 ** N

        def at(t):
            return vout[min(range(len(time)), key=lambda k: abs(time[k] - t))]

        .markdown(f"""
            # R-2R DAC
            The code counts from 0 to {2 ** N - 1}, one code every {STEP * 1e9:g} ns, with
            {LOAD}F on vout. Each code is checked {STEP * 0.1 * 1e9:g} ns before the next
            one against vdd * code / {2 ** N}, within {TOL} LSB ({TOL * lsb * 1e3:g} mV).
            """)
        rows = []
        for code in range(2 ** N):
            v = at((code + 0.9) * STEP)
            ideal = VDD * code / 2 ** N
            err = (v - ideal) / lsb
            rows.append(f"| {code} | {ideal:.4f} | {v:.4f} | {err:+.3f} |")
            .passfail(f"code {code}", abs(err) <= TOL,
                f"vout = {v:.4f} V, expected {ideal:.4f} V ({err:+.3f} LSB, limit {TOL} LSB)")
        .markdown("| code | ideal (V) | vout (V) | error (LSB) |\n|---|---|---|---|\n"
            + "\n".join(rows))
        .plot2d(sim.time, sim.vout, *(sim.d[i] for i in range(N)))
