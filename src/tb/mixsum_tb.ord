"""
Testbench of MixSum: sines of different frequencies on va and vb; vout is checked against
a Python reference model, vdd * (ideal(va) + ideal(vb)) / 8, wherever the ideal codes are
unambiguous and have been stable long enough for the output to settle.
"""

from ordec.core import *
from ordec.lib.base import Vsin, Vdc, Gnd
from ams.mixsum.mixsum import MixSum, N

VDD = 1.2
VREFN = 0.3
VREFP = 0.9
AMPL = 0.4              # sines around the middle of the reference range
FREQ_A = 0.2e6
FREQ_B = 0.32e6
TSTOP = 5e-6
TSTEP = 2e-9
MARGIN = 0.025          # inputs closer to a threshold are not checked (V)
SETTLE = 60e-9          # codes stable for this long before a check
TOL = 0.25              # allowed vout error, in DAC LSB (vdd / 8)


def thresholds() -> list[float]:
    lsb = (VREFP - VREFN) / 2 ** N
    return [VREFN + lsb * k for k in range(1, 2 ** N)]


def ideal(v: float) -> int:
    """Ideal ADC code: number of ladder taps below v."""
    return sum(v > t for t in thresholds())


def expected(va: float, vb: float) -> float:
    """Reference model of MixSum."""
    return VDD * (ideal(va) + ideal(vb)) / 2 ** (N + 1)


def volts_to_int(volts: list[float]) -> int:
    THRESH = VDD / 2
    value = 0
    for i, voltage in enumerate(volts):
        if voltage > THRESH:
            value += 2 ** i
    return value


cell MixsumTb:
    """va, vb: sines of FREQ_A, FREQ_B around (vrefn + vrefp) / 2."""

    viewgen schematic(self) -> Schematic:
        net vdd, vss, va, vb, vout, vrefp, vrefn
        MixSum dut:
            .pos = (30, 8)
            .vdd -- vdd; .vss -- vss; .va -- va; .vb -- vb; .vout -- vout
            .vrefp -- vrefp; .vrefn -- vrefn
        vcm = (VREFN + VREFP) / 2
        Vsin va_src: .pos=(2, 12); .$dc=vcm; .$amplitude=AMPL; .$freq=FREQ_A; .n -- vss; .p -- va
        Vsin vb_src: .pos=(8, 12); .$dc=vcm; .$amplitude=AMPL; .$freq=FREQ_B; .n -- vss; .p -- vb
        Vdc vrefp_src: .pos=(14, 12); .$dc=VREFP; .n -- vss; .p -- vrefp
        Vdc vrefn_src: .pos=(20, 12); .$dc=VREFN; .n -- vss; .p -- vrefn
        Vdc vdd_src: .pos=(24, 22); .$dc=VDD; .n -- vss; .p -- vdd
        Gnd gnd: .pos=(24, 0); .p -- vss

    viewgen sim_tran(self) -> Simulation:
        .simulate().tran(TSTEP, TSTOP)

    viewgen report_tran(self) -> Report:
        sim = self.sim_tran
        time = list(sim.time)
        va = list(sim.va.voltage)
        vb = list(sim.vb.voltage)
        vout = list(sim.vout.voltage)
        ref = [expected(a, b) for a, b in zip(va, vb)]
        lsb = VDD / 2 ** (N + 1)

        qa = list(map(volts_to_int, zip(*[list(sim.dut.qa[i].voltage) for i in range(N)])))
        qb = list(map(volts_to_int, zip(*[list(sim.dut.qb[i].voltage) for i in range(N)])))
        q = list(map(volts_to_int, zip(*[list(sim.dut.q[i].voltage) for i in range(N+1)])))

        # Checked: ideal codes unambiguous now and unchanged during the last SETTLE.
        def clear(v):
            return all(abs(v - t) > MARGIN for t in thresholds())
        checked = []
        last_change = 0.0
        for k in range(len(time)):
            if k and ref[k] != ref[k - 1]:
                last_change = time[k]
            if time[k] - last_change >= SETTLE and clear(va[k]) and clear(vb[k]):
                checked.append(k)

        .markdown(f"""
            # MixSum
            va and vb are sines of {AMPL} V amplitude around {(VREFN + VREFP) / 2:g} V at
            {FREQ_A / 1e6:g} MHz and {FREQ_B / 1e6:g} MHz (vrefn = {VREFN} V,
            vrefp = {VREFP} V). vout is compared with vdd · (ideal(va) + ideal(vb)) / 8
            within {TOL} LSB ({TOL * lsb * 1e3:g} mV) where both inputs are more than
            {MARGIN * 1e3:g} mV from a threshold and the ideal sum has been stable for
            {SETTLE * 1e9:g} ns. Each sum 0..{2 * (2 ** N - 1)} must be covered.
            """)
        rows = []
        for total in range(2 * (2 ** N - 1) + 1):
            ks = [k for k in checked if round(ref[k] / lsb) == total]
            errs = [(vout[k] - ref[k]) / lsb for k in ks]
            wrong = [k for k, e in zip(ks, errs) if abs(e) > TOL]
            worst = max(errs, key=abs) if errs else 0.0
            rows.append(f"| {total} | {len(ks)} | {len(wrong)} | {worst:+.3f} |")
            if not ks:
                msg = "not covered"
            elif wrong:
                k = wrong[0]
                msg = (f"{len(wrong)} of {len(ks)} samples off, first at {time[k] * 1e9:.0f} ns: "
                       f"vout = {vout[k]:.4f} V, expected {ref[k]:.4f} V")
            else:
                msg = ""
            .passfail(f"sum {total}", bool(ks) and not wrong, msg)
        .markdown("| sum | samples checked | off | worst error (LSB) |\n|---|---|---|---|\n"
            + "\n".join(rows))
        .plot2d(sim.time, sim.va, sim.vb, sim.vout, ("expected", ref))
        .plot2d(sim.time, ("QA", qa), ("QB", qb), ("Q", q))
