"""
Testbench of the 2-bit flash ADC: ramps vin across the reference range and checks the
output code against the ideal thresholds.
"""

from ordec.core import *
from ordec.lib.base import Vpwl, Vdc, Gnd
from ams.adc.adc import Adc, N

VDD = 1.2
VREFN = 0.3
VREFP = 0.9
OVER = 0.1      # ramp beyond the reference range on both sides
RAMP = 2e-6     # ramp duration
MARGIN = 0.025  # unchecked band around each threshold (offset + delay), in V


def ideal(v: float) -> int:
    """Ideal code: number of ladder taps below v."""
    lsb = (VREFP - VREFN) / 2 ** N
    return sum(v > VREFN + lsb * k for k in range(1, 2 ** N))


def thresholds() -> list[float]:
    lsb = (VREFP - VREFN) / 2 ** N
    return [VREFN + lsb * k for k in range(1, 2 ** N)]


cell AdcTb:
    """Slow ramp on vin from below vrefn to above vrefp."""

    viewgen schematic(self) -> Schematic:
        net vdd, vss, vin, vrefp, vrefn
        path d
        for i in range(N):
            net d[i]

        Adc dut:
            .pos = (30, 8)
            .vdd -- vdd; .vss -- vss; .vin -- vin
            .vrefp -- vrefp; .vrefn -- vrefn
            for i in range(N):
                .d[i] -- d[i]

        Vpwl vin_src:
            .pos = (2, 12)
            .$pwl = ((0, VREFN - OVER), (RAMP, VREFP + OVER))
            .n -- vss; .p -- vin
        Vdc vrefp_src: .pos=(10, 12); .$dc=VREFP; .n -- vss; .p -- vrefp
        Vdc vrefn_src: .pos=(18, 12); .$dc=VREFN; .n -- vss; .p -- vrefn
        Vdc vdd_src: .pos=(24, 20); .$dc=VDD; .n -- vss; .p -- vdd
        Gnd gnd: .pos=(24, 0); .p -- vss

    viewgen sim_tran(self) -> Simulation:
        .simulate().tran(1n, RAMP)

    viewgen report_tran(self) -> Report:
        sim = self.sim_tran
        vin = list(sim.vin.voltage)
        bits = [list(sim.d[i].voltage) for i in range(N)]
        codes = [sum((bits[i][k] > VDD / 2) << i for i in range(N)) for k in range(len(vin))]

        .markdown(f"""
            # 2-bit flash ADC
            vin ramps from {VREFN - OVER:g} V to {VREFP + OVER:g} V in {RAMP * 1e6:g} µs
            (vrefn = {VREFN} V, vrefp = {VREFP} V). The code is checked at every time step
            against the ideal code, except within ±{MARGIN * 1e3:g} mV of a threshold
            ({", ".join(f"{t:.3f}" for t in thresholds())} V).
            """)
        # Per code: checked samples, mismatches, measured vin range.
        rows = []
        for code in range(2 ** N):
            checked = [k for k in range(len(vin)) if ideal(vin[k]) == code
                       and all(abs(vin[k] - t) > MARGIN for t in thresholds())]
            wrong = [k for k in checked if codes[k] != code]
            seen = [vin[k] for k in range(len(vin)) if codes[k] == code]
            span = f"{min(seen):.3f} .. {max(seen):.3f}" if seen else "-"
            rows.append(f"| {code} | {len(checked)} | {len(wrong)} | {span} |")
            msg = (f"{len(wrong)} of {len(checked)} samples wrong, first at vin = "
                   f"{vin[wrong[0]]:.3f} V (code {codes[wrong[0]]})") if wrong else ""
            .passfail(f"code {code}", bool(checked) and not wrong, msg or "no samples")
        .markdown("| code | samples checked | wrong | vin with this code (V) |\n|---|---|---|---|\n"
            + "\n".join(rows))
        .plot2d(sim.time, sim.vin, *(sim.d[i] for i in range(N)))
